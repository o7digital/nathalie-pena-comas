---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Releases from "./Releases.astro";
import Story from "./Story.astro";
import Videos from "./Videos.astro";
import Platforms from "./Platforms.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Dialogs from "./Dialogs.astro";
import type { Locale } from "../data/translations";
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<Base lang={lang}><Header lang={lang}/><main id="main"><Hero lang={lang} /><Releases lang={lang} /><Story lang={lang} /><Videos lang={lang} /><Platforms lang={lang} /><Contact lang={lang} /></main><Footer lang={lang}/><Dialogs lang={lang}/></Base>
