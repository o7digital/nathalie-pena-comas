---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import International from './International.astro';
import Story from './Story.astro';
import Releases from './Releases.astro';
import Schedule from './Schedule.astro';
import Videos from './Videos.astro';
import Editorial from './Editorial.astro';
import Spirituosi from './Spirituosi.astro';
import Gallery from './Gallery.astro';
import Newsletter from './Newsletter.astro';
import Footer from './Footer.astro';
import Dialogs from './Dialogs.astro';
import type {Locale} from '../data/translations';
interface Props {lang:Locale}const {lang}=Astro.props;
---
<Base lang={lang}><Header lang={lang}/><main id="main"><Hero lang={lang}/><Story lang={lang}/><International lang={lang}/><Releases lang={lang}/><Schedule lang={lang}/><Videos lang={lang}/><Editorial lang={lang}/><Spirituosi lang={lang}/><Gallery lang={lang}/><Newsletter lang={lang}/></main><Footer lang={lang}/><Dialogs lang={lang}/></Base>
