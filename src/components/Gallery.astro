---
import {Image} from 'astro:assets';import recital from '../assets/official/recital.jpg';import opera from '../assets/official/portrait.jpg';import stage from '../assets/official/musikverein.jpg';import type {Locale} from '../data/translations';
interface Props {lang:Locale}const {lang}=Astro.props;const es=lang==='es';
const photos=[{src:opera,title:'La Traviata',credit:es?'Galería oficial':'Official gallery'},{src:recital,title:'IMAGO Sloveniae',credit:'© Mankica Kranjec'},{src:stage,title:'Musikverein, Wien',credit:'© David Moser'}];
---
<section class="photo-gallery section" id="gallery"><div class="section-top"><div><div class="kicker">{es?'Galería / Instantes de una vida artística':'Gallery / Moments of an artistic life'}</div><h2 class="section-title">{es?'El escenario.':'The stage.'}<br/><em>{es?'La emoción.':'The emotion.'}</em></h2></div></div><div class="photographs">{photos.map((photo,i)=><figure><Image src={photo.src} width={i===0?1280:1440} widths={[480,800,1280]} sizes="(max-width:780px) 85vw, 40vw" alt={`${photo.title} — Nathalie Peña-Comas · ${photo.credit}`} format="webp" loading="lazy"/><figcaption><span>{photo.title}</span><small>{photo.credit}</small></figcaption></figure>)}</div></section>
