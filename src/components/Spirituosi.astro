---
import {Image} from 'astro:assets';import ensemble from '../assets/official/spirituosi.jpg';import type {Locale} from '../data/translations';
interface Props {lang:Locale}const {lang}=Astro.props;const es=lang==='es';
---
<section class="spirituosi section" id="spirituosi"><div class="ensemble-photo"><Image src={ensemble} width={1920} widths={[640,960,1440,1920]} sizes="(max-width:780px) 100vw, 60vw" alt="Ensemble Spirituosi — fotografía oficial del sexteto" format="webp" loading="lazy" /></div><div class="ensemble-copy"><div class="kicker">{es?'Un proyecto muy personal':'A deeply personal project'}</div><h2>Ensemble<br/><em>Spirituosi</em></h2><p>{es?'La voz de Nathalie, la flauta de Evelyn y el violonchelo de Nicole Peña-Comas se encuentran con las guitarras de Damien Lancelle y Gonzalo Manrique y el contrabajo de Rubén Sánchez.':'Nathalie’s voice, Evelyn’s flute and Nicole Peña-Comas’s cello meet the guitars of Damien Lancelle and Gonzalo Manrique and Rubén Sánchez’s double bass.'}</p><p>{es?'Un sexteto que enlaza música clásica y tradiciones de América Latina y el Caribe. Su álbum Souvenir Latino recibió tres medallas de oro en los Global Music Awards 2018.':'A sextet connecting classical music with Latin American and Caribbean traditions. Their album Souvenir Latino received three gold medals at the 2018 Global Music Awards.'}</p><a href="https://www.nathaliepenacomas.net/projects" class="text-link">{es?'Descubrir el ensemble':'Discover the ensemble'} ↗</a></div></section>
