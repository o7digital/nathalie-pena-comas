---
import { Image } from "astro:assets";
import photo from "../assets/official/hero.jpg";
import { translations, type Locale } from "../data/translations";
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
---
    <section class="contact section" id="contact"><Image class="closing-photo" src={photo} width={1920} alt="Nathalie Peña-Comas" widths={[640,1280,1920]} sizes="(max-width: 780px) 1100px, 100vw" format="webp" loading="lazy"/><div class="closing-copy"><div class="kicker" set:html={t.contactKicker} /><h2 set:html={t.contactTitle} /><p set:html={t.contactDesc} /><a href="https://www.nathaliepenacomas.net/contact" target="_blank" rel="noopener" class="btn-gold"><span set:html={t.contactCTA} /><span class="btn-arrow">↗</span></a><a class="press-link" href="https://www.nathaliepenacomas.net/about-3" target="_blank" rel="noopener">{t.press} ↗</a><div class="social-links"><a href="https://www.instagram.com/nathaliepenacomas/" target="_blank" rel="noopener">Instagram ↗</a><a href="https://www.facebook.com/sopranopenacomas/" target="_blank" rel="noopener">Facebook ↗</a></div></div></section>
