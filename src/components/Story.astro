---
import {Image} from 'astro:assets';import artist from '../assets/official/editorial.jpg';import {translations,type Locale} from '../data/translations';
interface Props {lang:Locale}const {lang}=Astro.props;const es=lang==='es';const t=translations[lang];
---
<section class="story section" id="story"><div class="story-visual"><Image src={artist} width={1280} alt="Nathalie Peña-Comas — retrato oficial" widths={[480,800,1280]} sizes="(max-width:780px) 100vw, 60vw" format="webp" loading="lazy" /><span class="story-caption">Nathalie Peña-Comas / Soprano</span></div><div class="story-copy"><div class="kicker">{es?'La artista':'The artist'}</div><h2>{es?'Raíces latinas.':'Latin roots.'}<br/><em>{es?'Alma lírica.':'An operatic soul.'}</em></h2><p>{es?'Nacida en Santo Domingo y formada en la Universidad de Música y Artes Escénicas de Viena, Nathalie Peña-Comas une la ópera y el repertorio latinoamericano.':'Born in Santo Domingo and trained at Vienna’s University of Music and Performing Arts, Nathalie Peña-Comas brings together opera and Latin American repertoire.'}</p><p>{es?'De Mozart a Verdi, de Pamina a Violetta, su recorrido artístico se extiende también al teatro y a la música de cámara con Ensemble Spirituosi. Es embajadora cultural de la República Dominicana desde 2019.':'From Mozart to Verdi, Pamina to Violetta, her artistic journey also embraces theatre and chamber music with Ensemble Spirituosi. She has served as Cultural Ambassador for the Dominican Republic since 2019.'}</p><div class="repertoire"><div class="kicker">{es?'Selección de repertorio':'Selected repertoire'}</div><p>Mozart <span>Donna Anna · Pamina · Contessa</span></p><p>Verdi <span>Violetta · Messa da Requiem</span></p><p>Puccini <span>Musetta · La Bohème</span></p><a href="https://www.nathaliepenacomas.net/bio" class="repertoire-link">{es?'Ópera · Oratorio · Lied':'Opera · Oratorio · Art song'}</a></div><a class="text-link" href="https://www.nathaliepenacomas.net/bio" target="_blank" rel="noopener">{t.storyCTA} ↗</a></div></section>
