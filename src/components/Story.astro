---
import { localizer } from '../data/locales';
import Image from './ContentImage.astro';
import Biography from './Biography.astro';
import artist from '../assets/official/editorial.jpg';
import {type Locale} from '../data/translations';
import { sectionImage } from '../lib/cms';
import '../styles/biography.css';
const sectionPhoto = await sectionImage('story', artist);
interface Props {lang:Locale}
const {lang}=Astro.props;
const l = localizer(lang);
---
<section class="story section" id="about" aria-labelledby="about-title">
 <div class="story-visual"><Image src={sectionPhoto} width={1280} alt={l("Nathalie Peña-Comas — retrato oficial", "Nathalie Peña-Comas — official portrait")} widths={[480,800,1280]} sizes="(max-width:780px) 100vw, 60vw" format="webp" loading="lazy" /><span class="story-caption">{l("Nathalie Peña-Comas / Soprano")}</span></div>
 <div class="story-copy">
  <div class="kicker">{l("La artista", "The artist")}</div>
  <h2 id="about-title">{l("Raíces latinas.", "Latin roots.")}<br/><em>{l("Alma lírica.", "An operatic soul.")}</em></h2>
  <p>{l('Nathalie Peña-Comas es una soprano y actriz nacida en Santo Domingo, República Dominicana, y nominada al Latin Grammy.', 'Nathalie Peña-Comas is a Latin Grammy-nominated soprano and actress, born in Santo Domingo, Dominican Republic.')}</p>
  <p>{l('Formada en Viena, desarrolla una carrera que une la ópera, el teatro, la música de concierto y las raíces latinoamericanas. Desde 2019 es embajadora cultural de la República Dominicana.', 'Trained in Vienna, her career connects opera, theatre, concert music and Latin American roots. Since 2019, she has served as Cultural Ambassador for the Dominican Republic.')}</p>
  <aside class="story-philosophy"><span class="kicker">{l('Su visión artística', 'Her artistic vision')}</span><p>{l('Para Nathalie, cantar es un acto místico, espiritual y sanador. Su compromiso musical nace de ese propósito: una música para el alma.', 'For Nathalie, singing is mystical, spiritual and healing. Her musical commitment expresses that purpose: music for the soul.')}</p></aside>
  <div class="repertoire"><div class="kicker">{l("Selección de repertorio", "Selected repertoire")}</div><p>{l("Mozart")} <span>{l("Donna Anna · Pamina · Contessa")}</span></p><p>{l("Verdi")} <span>{l("Violetta · Messa da Requiem")}</span></p><p>{l("Puccini")} <span>{l("Musetta · La Bohème")}</span></p><a class="repertoire-link" href="#repertorio">{l('Explorar el repertorio completo', 'Explore the complete repertoire')} ↗</a></div>
  <a class="text-link story-voice-link" href="#media">{l("Escuchar su voz", "Hear her voice")} ↓</a>
 </div>
 <Biography lang={lang}/>
</section>
