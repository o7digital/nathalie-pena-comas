---
import { translations, type Locale } from "../data/translations";
import type { Universe } from "../data/universes";
import { classicalCopy } from "../data/classification";
interface Props { lang: Locale; universe: Universe }
const { lang, universe } = Astro.props;
const t = translations[lang];
const c = classicalCopy[lang];
---
    <section class="listen section" id="listen"><div class="listen-inner"><div><div class="kicker" set:html={t.listenKicker} /><h2 set:html={universe === "classical" ? c.listenTitle : t.listenTitle} /><p set:html={universe === "classical" ? c.listenDesc : t.listenDesc} /></div><div class="platform-list">{universe === "popular" && <><a class="platform" href="https://open.spotify.com/track/4BE0KqF21ot4HCBzuWR6aA" target="_blank" rel="noopener"><span>◉ Spotify</span><small>↗</small></a><a class="platform" href="https://www.youtube.com/playlist?list=OLAK5uy_mHA1R3O-jgMZLvy-NHTHpQBcDJ70HBQHk" target="_blank" rel="noopener"><span>▷ YouTube Music</span><small>↗</small></a></>}<a class="platform" href="https://music.apple.com/us/artist/nathalie-pe%C3%B1a-comas/1223241299" target="_blank" rel="noopener"><span>♫ Apple Music</span><small>↗</small></a><a class="platform" href="https://www.nathaliepenacomas.net/" target="_blank" rel="noopener"><span set:html={t.platformOfficial} /><small>↗</small></a></div></div></section>
