---
import {Image} from 'astro:assets';import {albums} from '../data/albums';import type {Locale} from '../data/translations';
interface Props {lang:Locale} const {lang}=Astro.props;const es=lang==='es';
---
<section class="featured section" id="music"><div class="featured-glow" aria-hidden="true"></div><div class="featured-art"><Image src={albums[0].image} width={960} alt="Quinto Elemento: Tierra — portada oficial" widths={[400,640,960]} sizes="(max-width:780px) 85vw, 42vw" format="webp" loading="lazy" /></div><article class="release-feature"><div class="kicker">02 / {es?'Proyecto destacado':'Featured release'}</div><span class="element-number" aria-hidden="true">V</span><h3>Quinto Elemento:<br/><em>Tierra</em></h3><p>{es?'La voz vuelve a su esencia. Una invitación a sentir la música desde la raíz.':'A voice returning to its essence. An invitation to feel music at its roots.'}</p><a class="btn-gold" href={albums[0].url} target="_blank" rel="noopener">{es?'Escuchar el álbum':'Listen to the album'} ↗</a></article></section>
<section class="collection section" id="collection"><div class="section-top"><div><div class="kicker">03 / {es?'Discografía seleccionada':'Selected recordings'}</div><h2 class="section-title">{es?'Un universo':'A world'}<br/><em>{es?'de matices.':'of expression.'}</em></h2></div><a class="text-link" href="https://www.nathaliepenacomas.net/recordings" target="_blank" rel="noopener">{es?'Toda la discografía':'Full discography'} ↗</a></div><div class="album-gallery">{albums.map((album,i)=><article class="album"><a href={album.url} target="_blank" rel="noopener" aria-label={`${es?'Escuchar':'Listen to'} ${album.title}`}><div class="album-art"><Image src={album.image} width={i===1?563:800} alt={album.title} widths={i===1?[320,563]:[320,560,800]} sizes="(max-width:600px) 78vw, (max-width:1000px) 42vw, 22vw" format="webp" loading="lazy" /><span class="album-listen">{es?'Escuchar':'Listen'} ↗</span></div><div class="album-meta"><span>0{i+1}</span><h3>{album.title}</h3><span>↗</span></div><p>{album.detail}</p></a></article>)}</div></section>
