---
import { localizer } from '../data/locales';
import { schedule, featuredConcert, concertText } from '../data/schedule';
import Image from './ContentImage.astro';
import concertPoster from '../assets/official/quinto-elemento-concert.jpg';
import '../styles/schedule.css';
import ConcertRow from './ConcertRow.astro';
import type { Locale } from '../data/translations';
interface Props { lang: Locale }
const {lang} = Astro.props, l = localizer(lang);
const today = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Mexico_City',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const upcoming = schedule.filter(event => event.date >= today).sort((a,b) => a.date.localeCompare(b.date));
const first = upcoming.slice(0,4), remaining = upcoming.slice(4);
const past = schedule.filter(event => event.date < today && event.url).sort((a,b) => b.date.localeCompare(a.date));
---
<section class="agenda section" id="schedule">
 <div class="section-top"><div><div class="kicker">{l("Agenda / En el escenario", "Schedule / On stage")}</div><h2 class="section-title">{l("Próximas", "Upcoming")}<br/><em>{l("actuaciones.", "performances.")}</em></h2></div><a href="#contact" class="text-link">{l("Consultar sobre conciertos", "Concert enquiries")} ↗</a></div>
 {featuredConcert && featuredConcert.date >= today && <article class="concert-spotlight" aria-labelledby="featured-concert-title">
  <a class="concert-spotlight-art" href={featuredConcert.url} target="_blank" rel="noopener noreferrer" aria-label={`Quinto Elemento: Tierra — ${l('Reservar entradas','Book tickets')}`}><Image src={concertPoster} width={1200} widths={[480,800,1200]} sizes="(max-width:780px) 85vw, 43vw" alt="Quinto Elemento: Tierra — Nathalie Peña-Comas" loading="lazy" /></a>
  <div class="concert-spotlight-copy"><span class="kicker">{l('Concierto destacado','Featured concert')}</span><h3 id="featured-concert-title">Quinto Elemento: <em>Tierra</em></h3><p class="concert-spotlight-artist">Nathalie Peña-Comas</p><p><time datetime="2027-04-07T20:30:00-04:00">{new Intl.DateTimeFormat(lang,{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(featuredConcert.date))} · 20:30</time><br/>Sala Carlos Piantini · Teatro Nacional Eduardo Brito<br/>Santo Domingo</p><a class="btn-gold" href={featuredConcert.url} target="_blank" rel="noopener noreferrer">{l('Reservar entradas','Book tickets')}</a></div>
 </article>}
 <div class="concert-list">{first.map(event => <ConcertRow event={event} lang={lang}/>)}</div>
 {remaining.length > 0 && <details class="concert-more"><summary><span class="concert-more-closed">{l("Ver agenda completa", "View full schedule")}</span><span class="concert-more-open">{l("Ver menos fechas", "Show fewer dates")}</span><small>+ {remaining.length}</small><span class="concert-more-icon" aria-hidden="true">＋</span></summary><div class="concert-list">{remaining.map(event => <ConcertRow event={event} lang={lang}/>)}</div></details>}
 {!upcoming.length && <p>{l("Las próximas fechas se anunciarán aquí.", "Upcoming dates will be announced here.")}</p>}
 {past.length > 0 && <details class="official-link-archive" data-official-links="concerts"><summary>{l('Archivo de actuaciones','Past performances')}</summary><ul>{past.map(event=><li><a href={event.url} target="_blank" rel="noopener noreferrer"><time datetime={event.date}>{new Intl.DateTimeFormat(lang,{dateStyle:'medium',timeZone:'UTC'}).format(new Date(event.date))}</time> · {concertText(event,'title',lang)}</a></li>)}</ul></details>}
 <p class="source-note">{l("Programa anunciado en el sitio oficial. Fechas sujetas a actualización.", "Programme announced on the official website. Dates subject to updates.")}</p>
</section>
