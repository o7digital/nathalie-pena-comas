---
import { universeCopy, universePath, type Universe } from '../data/universes';
import type { Locale } from '../data/translations';
interface Props { lang: Locale; universe: Universe }
const { lang, universe } = Astro.props;
const t = universeCopy[lang];
---
<nav class="universe-nav" aria-label={lang === 'es' ? 'Universos artísticos' : 'Artistic worlds'}>
 <a href={universePath(lang)} aria-label={t.home}>⌂ <span>{t.home}</span></a><span class="universe-divider">/</span>
 <a href={universePath(lang, 'classical')} aria-current={universe === 'classical' ? 'page' : undefined}>{t.shortClassical}</a>
 <a href={universePath(lang, 'popular')} aria-current={universe === 'popular' ? 'page' : undefined}>{t.shortPopular}</a>
</nav>
