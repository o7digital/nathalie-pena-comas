---
import { localizer } from '../data/locales';
import {Image} from 'astro:assets';
import {translations,type Locale} from '../data/translations';
import rusalka from '../assets/official/rusalka.jpg';
import boheme from '../assets/official/boheme.jpg';
import traviata from '../assets/official/traviata.jpg';
import carmina from '../assets/official/carmina.jpg';
import sombras from '../assets/sombras-video.jpg';
import esclavo from '../assets/esclavo-video.jpg';
import type {Universe} from '../data/universes';
interface Props {lang:Locale;universe:Universe}const {lang,universe}=Astro.props;const l = localizer(lang);const t=translations[lang];
const opera=[
 {id:'pG7lJPLcO-g',title:'Song to the Moon',detail:'Rusalka · A. Dvořák · MuTh, Vienna',image:rusalka},
 {id:'NrGZajhOGAc',title:'O soave fanciulla',detail:'La Bohème · G. Puccini · Ramón Vargas',image:boheme},
 {id:'U1QDrRtdnAI',title:'Addio del passato',detail:'La Traviata · G. Verdi · Santo Domingo',image:traviata},
 {id:'Ept9wg2IlDo',title:'In trutina',detail:'Carmina Burana · C. Orff · Târgu Mureș',image:carmina},
];
const films=[{id:'HbRmwVkSP8Q',title:'Sombras Nada Más',image:sombras},{id:'otT5_7vJYv4',title:'Esclavo y Amo',image:esclavo}];
---
<section class="films section" id="media"><div class="section-top"><div><div class="kicker">{l("Media / Selección de interpretaciones", "Media / Selected performances")}</div><h2 class="section-title">{universe === "classical" ? <>{l("El arte lírico,", "The operatic art,")}<br/><em>{l("en escena.", "on stage.")}</em></> : <>{l("Videos musicales", "Music films")}</>}</h2></div><a class="text-link" href="#collection">{l("Discografía seleccionada", "Selected recordings")} ↗</a></div>{universe === "classical" && <div class="video-grid classical-grid">{opera.map(v=><article class="video"><div class="video-frame"><Image src={v.image} width={480} alt={v.title} widths={[320,480]} sizes="(max-width:780px) 85vw, 34vw" format="webp" loading="lazy"/><button class="play" data-video={v.id} data-title={v.title} aria-label={t.play+' '+v.title}>▶</button></div><div class="video-meta"><div><h3>{v.title}</h3><span>{v.detail}</span></div><a class="arrow-link" href={'https://www.youtube.com/watch?v='+v.id} aria-label={t.play+' '+v.title} target="_blank" rel="noopener">↗</a></div></article>)}</div>}{universe === "popular" && <><div class="opera-heading section" id="music-films"><span class="kicker">{l("Otro lenguaje, la misma voz / Videos oficiales", "Another language, the same voice / Official music films")}</span></div><div class="video-grid music-film-grid">{films.map(v=><article class="video"><div class="video-frame"><Image src={v.image} width={960} widths={[480,800,1280]} sizes="(max-width:780px) 85vw, 42vw" alt={v.title} format="webp" loading="lazy"/><button class="play" data-video={v.id} data-title={v.title} aria-label={t.play+' '+v.title}>▶</button></div><div class="video-meta"><div><h3>{v.title}</h3><span>{t.officialVideo}</span></div><a class="arrow-link" href={'https://www.youtube.com/watch?v='+v.id} aria-label={t.play+' '+v.title} target="_blank" rel="noopener">↗</a></div></article>)}</div></>}</section>
