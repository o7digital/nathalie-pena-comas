---
import { translations, type Locale } from "../data/translations";
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
import { Image } from "astro:assets";
import sombrasCover from "../assets/sombras-cover.jpg";
import esclavoCover from "../assets/esclavo-cover.jpg";
---
<section class="release section" id="singles"><div class="section-top"><div><div class="kicker" set:html={t.releaseKicker}/><h2 class="section-title" set:html={t.releaseTitle}/></div><p class="section-intro" set:html={t.releaseDesc}/></div><div class="releases-grid"><article class="song-card"><div class="song-art"><Image loading="lazy" src={sombrasCover} alt="Sombras Nada Más" widths={[480, 800, 1280]} sizes="(max-width: 780px) 100vw, 65vw" format="webp" /><span class="release-tag" set:html={t.releaseBadge} /><button class="play" aria-label={t.play + " Sombras Nada Más"} data-video="HbRmwVkSP8Q">▶</button></div><div class="song-details"><h3>Sombras Nada Más</h3><p>NATHALIE PEÑA-COMAS · 03:51</p><div class="music-links"><a target="_blank" rel="noopener" href="https://www.youtube.com/watch?v=HbRmwVkSP8Q">▶ YouTube</a><a target="_blank" rel="noopener" href="https://music.apple.com/us/album/sombras-nada-m%C3%A1s-single/6808254287">♫ Apple Music</a></div></div></article>
        <article class="song-card"><div class="song-art"><Image loading="lazy" src={esclavoCover} alt="Esclavo y Amo" widths={[480, 800, 1280]} sizes="(max-width: 780px) 100vw, 65vw" format="webp" /><span class="release-tag" set:html={t.releaseBadge} /><button class="play" aria-label={t.play + " Esclavo y Amo"} data-video="otT5_7vJYv4">▶</button></div><div class="song-details"><h3>Esclavo y Amo</h3><p>NATHALIE PEÑA-COMAS · 03:32</p><div class="music-links"><a target="_blank" rel="noopener" href="https://www.youtube.com/watch?v=otT5_7vJYv4">▶ YouTube</a><a target="_blank" rel="noopener" href="https://open.spotify.com/track/4BE0KqF21ot4HCBzuWR6aA">◉ Spotify</a><a target="_blank" rel="noopener" href="https://music.apple.com/us/album/esclavo-y-amo/6781307613">♫ Apple Music</a></div></div></article>
      </div></section>
