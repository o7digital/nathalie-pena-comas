---
import {Image} from 'astro:assets';
import press from '../assets/official/press-oh.jpeg';
import type {Locale} from '../data/translations';
interface Props {lang:Locale}const {lang}=Astro.props;const es=lang==='es';
---
<section class="editorial section" id="news"><div class="section-top"><div><div class="kicker">{es?'Diario de una artista':'An artist’s journal'}</div><h2 class="section-title">Press <em>&</em> News</h2></div><p class="section-intro">{es?'En los medios, entre bastidores y sobre el escenario. Una selección del archivo oficial.':'In the press, behind the scenes and on stage. A selection from the official archive.'}</p></div><div class="journal-grid"><a class="press-feature" href="https://www.nathaliepenacomas.net/about-3"><Image src={press} width={605} widths={[320,605]} sizes="(max-width:780px) 85vw, 30vw" alt="Nathalie Peña-Comas — portada de Oh! Magazine, archivo de prensa oficial" format="webp" loading="lazy"/><div><span class="kicker">{es?'Archivo de prensa':'Press archive'} / Oh! Magazine</span><h3>{es?'La artista,':'The artist,'}<br/><em>{es?'en portada.':'in the spotlight.'}</em></h3><span class="text-link">{es?'Explorar la prensa':'Explore the press'} ↗</span></div></a><div class="news-list"><a href="https://www.nathaliepenacomas.net/latest"><time datetime="2024-12-06">06.12.2024 / NEWS ARCHIVE</time><h3>{es?'Cine y devoción dominicana':'Film and Dominican devotion'}</h3><p>{es?'Nathalie participa en un documental de Larimar Films sobre la Virgen de la Altagracia.':'Nathalie joins a Larimar Films documentary exploring devotion to Our Lady of Altagracia.'}</p><span class="text-link">{es?'Leer la noticia':'Read the story'} ↗</span></a><a href="https://www.nathaliepenacomas.net/latest"><time datetime="2024-04-22">22.04.2024 / NEWS ARCHIVE</time><h3>Donna Anna / Don Giovanni</h3><p>{es?'El debut de Nathalie como Donna Anna en el Wiener Opernsommer, en el Belvedere de Viena.':'Nathalie’s role debut as Donna Anna at Wiener Opernsommer, in Vienna’s Belvedere.'}</p><span class="text-link">{es?'Ver el archivo de noticias':'View the news archive'} ↗</span></a></div></div></section>
