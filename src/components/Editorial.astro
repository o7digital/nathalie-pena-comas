---
import { localizer } from '../data/locales';
import {Image} from 'astro:assets';
import press from '../assets/official/press-oh.jpeg';
import type {Locale} from '../data/translations';
import type {Universe} from '../data/universes';
interface Props {lang:Locale;universe:Universe}const {lang,universe}=Astro.props;const l = localizer(lang);
---
<section class="editorial section" id="news"><div class="section-top"><div><div class="kicker">{l("Diario de una artista", "An artist’s journal")}</div><h2 class="section-title">{l("Prensa", "Press")} <em>&</em> {l("Noticias", "News")}</h2></div><p class="section-intro">{l("En los medios, entre bastidores y sobre el escenario. Una selección del archivo oficial.", "In the press, behind the scenes and on stage. A selection from the official archive.")}</p></div><div class="journal-grid"><article class="press-feature section" id="press" aria-labelledby="press-title"><Image src={press} width={605} widths={[320,605]} sizes="(max-width:780px) 85vw, 30vw" alt={l("Nathalie Peña-Comas — portada de Oh! Magazine", "Nathalie Peña-Comas — Oh! Magazine cover")} format="webp" loading="lazy"/><div><span class="kicker">{l("Archivo de prensa", "Press archive")} / Oh! Magazine</span><h3 id="press-title">{l("La artista,", "The artist,")}<br/><em>{l("en portada.", "in the spotlight.")}</em></h3><p>{l("Su archivo de prensa reúne portadas y artículos de Oh! Magazine, En Sociedad y Corriere Romagna, entre otros medios. La portada reproducida forma parte de esa selección oficial.", "Her press archive includes covers and articles from Oh! Magazine, En Sociedad and Corriere Romagna, among other publications. The cover shown here is part of that official selection.")}</p><a class="text-link" href="#contact">{l("Prensa y entrevistas", "Press & interview enquiries")} ↓</a></div></article><div class="news-list">{universe === "popular" && <article><time datetime="2026-10-13">13.10.2026 / {l("PROYECTO MUSICAL", "MUSIC PROJECT")}</time><h3>Quinto Elemento: Tierra</h3><p>{l("El programa oficial anunció la presentación del álbum el 13 de octubre de 2026 en el Teatro Nacional Eduardo Brito, Santo Domingo. Descubre el proyecto y sus interpretaciones en las plataformas musicales.", "The official programme announced the album presentation on 13 October 2026 at Teatro Nacional Eduardo Brito, Santo Domingo. Explore the project and its performances on music platforms.")}</p><a class="text-link" href="#music">{l("Descubrir el álbum", "Discover the album")} ↓</a></article>}<article><time datetime="2024-12-06">06.12.2024 / {l("ARCHIVO DE NOTICIAS", "NEWS ARCHIVE")}</time><h3>{l("Cine y devoción dominicana", "Film and Dominican devotion")}</h3><p>{l("El archivo oficial anunció la participación de Nathalie en un documental de Larimar Films sobre la historia de la devoción a la Virgen de la Altagracia, una figura profundamente ligada a la cultura dominicana.", "The official archive announced Nathalie’s participation in a Larimar Films documentary on the history of devotion to Our Lady of Altagracia, a figure deeply connected to Dominican culture.")}</p></article>{universe === "classical" && <article><time datetime="2024-04-22">22.04.2024 / {l("ARCHIVO DE NOTICIAS", "NEWS ARCHIVE")}</time><h3>Donna Anna / Don Giovanni</h3><p>{l("El Wiener Opernsommer presentó a Nathalie en su debut como Donna Anna en Don Giovanni de Mozart. La producción se anunció para julio de 2024 en el palacio Belvedere de Viena.", "Wiener Opernsommer presented Nathalie’s role debut as Donna Anna in Mozart’s Don Giovanni. The production was announced for July 2024 at Vienna’s Belvedere Palace.")}</p><a class="text-link" href="#media">{l("Escuchar sus interpretaciones", "Hear her performances")} ↓</a></article>}</div></div></section>
