---
import { localizer } from '../data/locales';
import type {Locale} from '../data/translations';
interface Props {lang:Locale} const {lang}=Astro.props;const l = localizer(lang);
const rows=[
 [l('Latin Grammy'),l('Nominada · Alta Gracia','Nominee · Alta Gracia')],
 [l('Ebe Stignani'),l('Primer premio · Concurso internacional de ópera, 2022','First prize · International opera competition, 2022')],
 [l('Sin fronteras','Beyond borders'),l('Europa · América · Asia','Europe · The Americas · Asia')],
 [l('En diálogo','In conversation'),l('Andrea Bocelli · Ramón Vargas · Ensemble Spirituosi')],
];
---
<section class="international section" id="voice"><div class="section-top"><div><div class="kicker">{l("Una voz internacional", "An international voice")}</div><h2 class="section-title">{l("La voz de", "The voice of")}<br/><em>{l("una trayectoria.", "an artist.")}</em></h2></div><p class="section-intro">{l("De la tradición operística europea al alma de la música latinoamericana. Una trayectoria que une culturas.", "From the European operatic tradition to the soul of Latin American music. A career connecting cultures.")}</p></div><div class="honors">{rows.map(([title,desc],i)=><div class="honor"><span class="honor-index">0{i+1}</span><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
