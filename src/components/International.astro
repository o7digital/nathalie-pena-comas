---
import type {Locale} from '../data/translations';
interface Props {lang:Locale} const {lang}=Astro.props;const es=lang==='es';
const rows=es?[['Latin Grammy','Nominada · Alta Gracia'],['Ebe Stignani','Primer premio · Concurso internacional de ópera, 2022'],['Sin fronteras','Europa · América · Asia'],['En diálogo','Andrea Bocelli · Ramón Vargas · Ensemble Spirituosi']]:[['Latin Grammy','Nominee · Alta Gracia'],['Ebe Stignani','First prize · International opera competition, 2022'],['Beyond borders','Europe · The Americas · Asia'],['In conversation','Andrea Bocelli · Ramón Vargas · Ensemble Spirituosi']];
---
<section class="international section" id="voice"><div class="section-top"><div><div class="kicker">{es?'Una voz internacional':'An international voice'}</div><h2 class="section-title">{es?'La voz de':'The voice of'}<br/><em>{es?'una trayectoria.':'an artist.'}</em></h2></div><p class="section-intro">{es?'De la tradición operística europea al alma de la música latinoamericana. Una trayectoria que une culturas.':'From the European operatic tradition to the soul of Latin American music. A career connecting cultures.'}</p></div><div class="honors">{rows.map(([title,desc],i)=><div class="honor"><span class="honor-index">0{i+1}</span><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
