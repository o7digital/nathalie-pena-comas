---
import { Image } from 'astro:assets';
import hero from '../assets/official/hero.jpg';
import type { Locale } from '../data/translations';
interface Props { lang: Locale }
const {lang}=Astro.props; const es=lang==='es';
---
<section class="hero signature-hero section" aria-labelledby="hero-title">
  <div class="hero-portrait"><Image src={hero} class="hero-photo" width={2560} alt="Nathalie Peña-Comas — fotografía oficial, retrato profesional" widths={[640,960,1440,1920,2560]} sizes="(max-width: 780px) 1440px, 75vw" format="webp" quality={90} loading="eager" fetchpriority="high" /></div>
  <div class="hero-inner fade-in"><div class="eyebrow">{es?'Soprano internacional · Actriz':'International soprano · Actress'}</div><h1 id="hero-title">Nathalie<br/><em>Peña-Comas</em></h1><p class="hero-sub">{es?'Una vida dedicada':'A life devoted'}<br/><em>{es?'al arte de la voz.':'to the art of the voice.'}</em></p><p class="hero-description">{es?'Ópera, escenario y raíces. El universo artístico de una soprano dominicana formada en Viena.':'Opera, stage and roots. The artistic world of a Dominican soprano trained in Vienna.'}</p><div class="hero-ctas"><a class="btn-gold" href="#story">{es?'Conocer a Nathalie':'Discover Nathalie'} ↗</a><a class="btn-outline" href="#schedule">{es?'Próximos conciertos':'Upcoming performances'} ↓</a></div></div>
  <div class="hero-bottom"><span>LATIN GRAMMY NOMINEE</span><a href="#voice">{es?'La artista y su mundo':'The artist & her world'} ↓</a><button data-video="pG7lJPLcO-g" data-title="Song to the Moon">▷ Song to the Moon</button></div>
</section>
