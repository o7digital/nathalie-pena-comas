---
import { translations, type Locale } from '../data/translations';
import { classicalCopy } from '../data/classification';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
const c = classicalCopy[lang];
---
<section class="hero classical-hero section" aria-labelledby="hero-title">
 <div class="classical-ornament" aria-hidden="true">N<span>PC</span></div><div class="hero-grid"></div>
 <div class="hero-inner fade-in"><div class="eyebrow">{c.kicker}</div><h1 id="hero-title">Nathalie<br/><em>Peña-Comas</em></h1><p class="hero-sub">{c.sub}</p><p class="hero-desc">{c.desc}</p><div class="hero-ctas"><a href="#story" class="btn-gold">{c.journey} ↗</a><a href="https://www.nathaliepenacomas.net/" target="_blank" rel="noopener" class="btn-outline" set:html={t.official} /></div></div>
 <div class="hero-index">01 —<span>{c.sub}</span></div>
</section>
<div class="marquee" aria-hidden="true"><span>{c.sub}</span><b>✦</b><span set:html={t.marqueeOne} /><b>✦</b><span>Nathalie Peña-Comas</span></div>
