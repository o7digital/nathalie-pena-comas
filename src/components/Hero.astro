---
import { Image } from 'astro:assets';
import hero from '../assets/official/hero.jpg';
import { translations, type Locale } from '../data/translations';
interface Props { lang: Locale }
const {lang}=Astro.props; const t=translations[lang]; const es=lang==='es';
---
<section class="hero section" aria-labelledby="hero-title">
 <Image src={hero} class="hero-photo" width={2560} alt="Nathalie Peña-Comas" widths={[640,960,1440,1920,2560]} sizes="(max-width: 780px) 1440px, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
 <div class="hero-inner fade-in"><div class="eyebrow">SOPRANO · INTERNATIONAL ARTIST</div><h1 id="hero-title">Nathalie<br/><em>Peña-Comas</em></h1><p class="hero-sub">{es?'El mundo, su escenario.':'The world, her stage.'}</p><div class="hero-ctas"><a class="btn-gold" href="#story">{es?'Descubrir a la artista':'Discover the artist'} <span>↗</span></a><a class="btn-outline" href="#music">{es?'Explorar la música':'Explore the music'} <span>↗</span></a></div></div>
 <div class="hero-bottom"><span>{es?'RAÍCES DOMINICANAS. ALMA UNIVERSAL.':'DOMINICAN ROOTS. A UNIVERSAL SOUL.'}</span><a href="#voice">{es?'Desliza para descubrir':'Scroll to discover'} ↓</a><button data-video="HbRmwVkSP8Q">▷ {t.heroWatch}</button></div>
</section>
