---
import { localizer } from '../data/locales';
import SocialLinks from './SocialLinks.astro';
import {translations,type Locale} from '../data/translations';
import {navigation,sectionHref} from '../data/navigation';
interface Props {lang:Locale}const {lang}=Astro.props;const l = localizer(lang);const t=translations[lang];
const isHome=Astro.url.pathname===`/${lang}/`;
---
<footer class="footer"><section class="footer-top section" id="contact" aria-label={l("Contacto profesional", "Professional contact")}><a href={sectionHref('home',lang,isHome)} class="brand official-brand" aria-label={`Nathalie Peña-Comas — ${l("Inicio", "Home")}`}><img src="/logo-npc.png" alt="Nathalie Peña Comas — NPC" width="529" height="330" /></a><div class="representation"><div class="kicker">{l("Contacto y representación", "Contact & representation")}</div><p>Künstlersekretariat Buchmann <span>{l("Representación de conciertos · Mundial", "Concert management · Worldwide")}</span></p><a href="mailto:office@buchmann.at" class="text-link">office@buchmann.at</a><p>Opera Connection <span>{l("Representación operística", "Opera management")}</span></p><a href="mailto:info@opera-connection.com" class="text-link">info@opera-connection.com</a></div></section><SocialLinks lang={lang}/><nav class="footer-navigation" aria-label={l("Navegación del pie de página", "Footer navigation")}>{navigation.map(({id,...labels})=><a href={sectionHref(id,lang,isHome)}>{l(labels.es, labels.en)}</a>)}</nav><div class="footer-bottom"><span>© 2026 NATHALIE PEÑA-COMAS</span><div class="footer-links"><a href={`/${lang}/privacy/`}>{t.privacy}</a><button class="privacy-button" data-preferences>{t.preferences}</button></div></div></footer>
