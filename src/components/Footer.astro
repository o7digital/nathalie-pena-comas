---
import { localizer } from '../data/locales';
import SocialLinks from './SocialLinks.astro';
import {translations,type Locale} from '../data/translations';
import {navigation,sectionHref} from '../data/navigation';
interface Props {lang:Locale}const {lang}=Astro.props;const l = localizer(lang);const t=translations[lang];
const isHome=Astro.url.pathname===`/${lang}/`;
---
<footer class="footer"><section class="footer-top section" id="contact" aria-label={l("Contacto profesional", "Professional contact")}><a href={sectionHref('home',lang,isHome)} class="brand official-brand" aria-label={`Nathalie Peña-Comas — ${l("Inicio", "Home")}`}><img src="/logo-npc.png" alt="Nathalie Peña Comas — NPC" width="529" height="330" /></a><div class="representation"><div class="kicker">{l("Contacto y representación", "Contact & representation")}</div><p>{l("Künstlersekretariat Buchmann")} <span>{l("Representación de conciertos · Mundial", "Concert management · Worldwide")}</span></p><a href={`mailto:${l("office@buchmann.at")}`} class="text-link">{l("office@buchmann.at")}</a><p>{l("Opera Connection")} <span>{l("Representación operística", "Opera management")}</span></p><a href={`mailto:${l("info@opera-connection.com")}`} class="text-link">{l("info@opera-connection.com")}</a></div></section><SocialLinks lang={lang}/><nav class="footer-navigation" aria-label={l("Navegación del pie de página", "Footer navigation")}>{navigation.map(({id,...labels})=><a href={sectionHref(id,lang,isHome)}>{l(labels.es, labels.en)}</a>)}</nav>
<div class="footer-return"><a class="back-to-top" href="#top"><span>{l("Volver arriba", "Back to top")}</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5m-6 6 6-6 6 6" /></svg></a></div>
<div class="footer-bottom"><span>{l("© 2026 NATHALIE PEÑA-COMAS")}</span><div class="footer-links"><a href={`/${lang}/privacy/`}>{t.privacy}</a><button class="privacy-button" data-preferences>{t.preferences}</button></div></div></footer>

<style>
 .footer-return{display:flex;justify-content:flex-end;margin-top:32px}
 .back-to-top{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:46px;max-width:100%;padding:12px 20px;border:1px solid var(--gold);border-radius:28px;color:var(--gold2);font:12px/1.5 var(--sans);letter-spacing:.04em;transition:background .2s,color .2s}
 .back-to-top svg{width:19px;height:19px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
 .back-to-top:hover{background:var(--gold);color:var(--bg)}
 .back-to-top:focus-visible{outline:2px solid var(--gold2);outline-offset:5px}
 @media(max-width:780px){.footer-return{justify-content:center;margin-top:28px}.back-to-top{min-height:48px;padding:12px 22px}}
</style>
