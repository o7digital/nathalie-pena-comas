---
import { translations, type Locale } from "../data/translations";
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
---

  <footer class="footer"><div class="footer-top"><a href="#top" class="brand">NATHALIE<br/>PEÑA-COMAS<span>SOPRANO · ARTIST</span></a><div class="footer-links"><a href={`/${lang}/privacy/`}>{t.privacy}</a><button class="privacy-button" data-preferences>{t.preferences}</button><a href={`/${lang}/popular/#music`} set:html={t.navMusic} /><a href={`/${lang}/classical/#story`} set:html={t.navStory} /><a href={`/${lang}/popular/#videos`} set:html={t.navVideos} /><a href="https://www.nathaliepenacomas.net/" target="_blank" rel="noopener" set:html={t.official} /></div></div><div class="footer-bottom"><span>© 2026 NATHALIE PEÑA-COMAS</span><span set:html={t.footerNote} /></div></footer>
