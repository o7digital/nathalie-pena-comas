---
import {translations,type Locale} from '../data/translations';
import {navigation,officialOrigin} from '../data/navigation';
interface Props {lang:Locale}const {lang}=Astro.props;const es=lang==='es';const t=translations[lang];
---
<footer class="footer" id="contact"><div class="footer-top"><a href={`/${lang}/`} class="brand official-brand" aria-label="Nathalie Peña-Comas — Home"><img src="/logo-npc.png" alt="Nathalie Peña Comas — logo NPC oficial" width="529" height="330" /></a><div class="representation"><div class="kicker">{es?'Contacto y representación':'Contact & representation'}</div><p>Künstlersekretariat Buchmann <span>Concert Management</span></p><p>Opera Connection <span>Opera Management</span></p><a href="https://www.nathaliepenacomas.net/contact" class="text-link">{es?'Contactos profesionales':'Professional enquiries'} ↗</a></div><div class="footer-social"><a href="https://www.instagram.com/nathaliepenacomas/">Instagram ↗</a><a href="https://www.facebook.com/sopranopenacomas/">Facebook ↗</a><a class="platform" href="https://open.spotify.com/artist/3lDJkwtZmncXJuv2BUpB80">Spotify ↗</a></div></div><nav class="footer-navigation" aria-label={es?'Navegación del pie de página':'Footer navigation'}>{navigation.map(({label,path})=><a href={path==='/'?`/${lang}/`:officialOrigin+path}>{label}</a>)}</nav><div class="footer-bottom"><span>© 2026 NATHALIE PEÑA-COMAS</span><div class="footer-links"><a href={`/${lang}/privacy/`}>{t.privacy}</a><button class="privacy-button" data-preferences>{t.preferences}</button></div></div></footer>
