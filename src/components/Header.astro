---
import { translations, type Locale } from '../data/translations';
import { navigation, sectionHref } from '../data/navigation';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
const isHome = Astro.url.pathname === `/${lang}/`;
---
<header class="nav" id="site-header">
  <a class="brand official-brand" href={sectionHref('home',lang,isHome)} aria-label={`Nathalie Peña-Comas — ${lang==='es'?'Inicio':'Home'}`}><img src="/logo-npc.png" alt="Nathalie Peña Comas — NPC" width="529" height="330" /></a>
  <nav class="navlinks" id="navlinks" aria-label={t.navLabel}>
    {navigation.map(({id,...labels}) => <a href={sectionHref(id,lang,isHome)} aria-current={isHome && id==='home'?'location':undefined}>{labels[lang]}</a>)}
  </nav>
  <div class="navright"><div class="language-switch" aria-label={lang==='es'?'Idioma':'Language'}><a href="/es/" lang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a><span>/</span><a href="/en/" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div><button class="hamburger" id="menu-btn" aria-controls="navlinks" aria-expanded="false" aria-label={t.menu}>☰</button></div>
</header>
