---
import { translations, type Locale } from '../data/translations';
import { navigation, officialOrigin } from '../data/navigation';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
---
<header class="nav" id="site-header">
  <a class="brand official-brand" href={`/${lang}/`} aria-label="Nathalie Peña-Comas — Home"><img src="/logo-npc.png" alt="Nathalie Peña Comas — logo NPC oficial" width="529" height="330" /></a>
  <nav class="navlinks" id="navlinks" aria-label={t.navLabel}>
    {navigation.map(({label,path}) => <a href={path === '/' ? `/${lang}/` : officialOrigin + path} aria-current={path === '/' ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="navright"><div class="language-switch" aria-label="Language"><a href="/es/" lang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a><span>/</span><a href="/en/" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div><button class="hamburger" id="menu-btn" aria-controls="navlinks" aria-expanded="false" aria-label={t.menu}>☰</button></div>
</header>
