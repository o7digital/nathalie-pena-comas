---
import { translations, type Locale } from "../data/translations";
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
---

  <div class="announcement" set:html={t.announcement} />
  <header class="nav" id="site-header">
    <a class="brand" href="#top" aria-label="Nathalie Peña-Comas">NATHALIE<br/>PEÑA-COMAS<span>SOPRANO · ARTIST</span></a>
    <nav class="navlinks" id="navlinks" aria-label={t.navLabel}><a href="#music" set:html={t.navMusic} /><a href="#story" set:html={t.navStory} /><a href="#videos" set:html={t.navVideos} /><a href="#listen" set:html={t.navListen} /><a href="#contact" set:html={t.navContact} /></nav>
    <div class="navright"><div class="language-switch" aria-label="Language"><a href="/es/" lang="es" aria-current={lang === "es" ? "page" : undefined}>ES</a><span>/</span><a href="/en/" lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a></div><a class="navcta" href="#music" set:html={t.navNew} /><button class="hamburger" id="menu-btn" aria-controls="navlinks" aria-expanded="false" aria-label={t.menu}>☰</button></div>
  </header>
